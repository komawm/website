{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "komawm-website",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-01",
  "routes": [
    {
      "pattern": "komawm.org",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
}
