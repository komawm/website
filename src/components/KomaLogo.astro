---
interface Props {
  size?: number;
}
const { size = 26 } = Astro.props;
---

<span
  class:list={["koma-logo-mark", size === 26 ? "is-md" : "is-sm"]}
  aria-hidden="true"
>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M 12 26 C 17.5 23.2 23.8 15.8 27.2 10.6 C 28.2 9.1 29.2 9.8 28.4 13 C 25.8 23.4 19.5 42 18 50.4 C 17.4 53.6 20.4 53.8 21.6 48.8 C 24 34 35.5 16.5 45.6 11.8 C 49.4 10 51 13.8 47.4 18 C 42.5 23.8 27.8 25.4 29 31 C 34 48 49 49 53 42" />
    <path d="M 44 42 L 53 42 L 50 51" />
  </svg>
</span>

<style>
  .koma-logo-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 0;
    padding: 0;
    color: var(--logo-stroke);
    flex-shrink: 0;
  }
  .koma-logo-mark.is-sm {
    width: 25px;
    height: 25px;
  }
  .koma-logo-mark.is-md {
    width: 26px;
    height: 26px;
  }
  .koma-logo-mark svg {
    width: 100%;
    height: 100%;
  }
</style>
