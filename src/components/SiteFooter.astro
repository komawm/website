---
import { getUiMessages, type SiteLocale } from "../lib/i18n.ts";

interface Props {
  locale?: SiteLocale;
}

const { locale = "en" } = Astro.props;
const t = getUiMessages(locale);
---

<footer class="site-footer">
  <div class="footer-inner">
    <span>{`komawm.org · ${t.footerNote}`}</span>
    <div class="footer-links">
      <a href="https://github.com/komawm/koma">komawm/koma</a>
      <a href="https://github.com/komawm/jiku">komawm/jiku</a>
      <a href="https://github.com/komawm/docs">komawm/docs</a>
      <a href="https://github.com/komawm/koma-types">koma-types</a>
      <a href="https://github.com/komawm/packaging">packaging</a>
      <a href="https://github.com/komawm/website">website</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--border-hairline);
    padding: 1rem 1.25rem;
    font-size: 0.76rem;
    color: var(--fg-muted);
  }
  .footer-inner {
    max-width: 82rem;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.73rem;
  }
  .footer-links a {
    color: var(--fg-secondary);
    text-decoration: none;
  }
  .footer-links a:hover {
    color: var(--accent);
  }
</style>
