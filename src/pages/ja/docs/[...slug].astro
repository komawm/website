---
import ManualPage from "../../../components/ManualPage.astro";
import { listSurfaceSlugs } from "../../../lib/manualDocs.ts";

export async function getStaticPaths() {
  const slugs = await listSurfaceSlugs("koma");
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
---
<ManualPage locale="ja" surface="koma" fullSlug={slug!} />
