/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), microphone=()
  Content-Security-Policy: default-src 'self'; img-src 'self' https://cdn.komawm.org data:; media-src 'self' https://cdn.komawm.org; font-src 'self' https://cdn.komawm.org; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/search-index.json
  Cache-Control: public, max-age=300

/jiku/search-index.json
  Cache-Control: public, max-age=300
